# --- Site ---
# Public HTTPS origin. Used for canonical links, sitemap, ads.txt and the
# PayOS return URL. AdSense will not accept an http origin or a platform
# default domain, so this must be your real custom domain.
APP_URL="https://your-domain.com"

# Real contact address shown on Contact, Privacy and the footer.
CONTACT_EMAIL="hello@your-domain.com"

# Salt for hashing visitor IPs before they are stored in usage_daily.
# REQUIRED for anonymous visitors: without it the server cannot count their AI
# usage and will refuse every AI call. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""

# HTTP port. Cloud Run and Railway inject PORT automatically.
PORT=3000


# --- AI ---
# Server-side only. Never prefix with VITE_.
GEMINI_API_KEY=""

# Optional. When set, Whisper is preferred for word-level timestamps because it
# is more accurate than Gemini for transcription.
OPENAI_API_KEY=""


# --- Supabase (Google login + database) ---
SUPABASE_URL=""
# Safe to expose to the browser only through VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=""
# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""


# --- PayOS ---
# NOTE: payOS has NO sandbox. Every call hits production, and an unpaid link
# simply expires, so test with the smallest amount you can.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
# Channel checksum key. Signs both the create-order request and incoming
# webhooks. Without it payOS rejects orders and we ignore webhooks, so payments
# would never activate.
PAYOS_CHECKSUM_KEY=""
# Only override for a self-hosted gateway; the correct production host is
# https://api-merchant.payos.vn
PAYOS_API_BASE=""


# --- Google AdSense ---
# ca-pub-XXXXXXXXXXXXXXXX. Leave empty until the account is approved; ads.txt is
# then served empty, which is expected.
ADSENSE_CLIENT_ID=""
# Slot ids created inside the AdSense dashboard.
ADSENSE_SLOT_HEADER=""
ADSENSE_SLOT_SIDEBAR=""
ADSENSE_SLOT_INFEED=""

# Google Consent Mode v2. Keep "true" for EEA/UK visitors.
CONSENT_REQUIRED="true"

# Optional GA4 measurement id.
GA_MEASUREMENT_ID=""


# --- Client (build time) ---
# These two ARE bundled into the browser, which is why only the anon key is
# allowed here. The service role key must stay server-side.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""