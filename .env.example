# GEMINI_API_KEY: Required for Gemini AI API calls (transcription, alignment, design).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. If provided, Whisper is used first for higher quality word-level timestamps.
OPENAI_API_KEY=""

# APP_URL: Public URL where this app is hosted. Used for canonical links, sitemap and ads.txt.
APP_URL="https://lyricstudio-ai.example.com"

# PORT: HTTP port the server listens on. Cloud Run injects PORT automatically.
PORT=3000

# --- Google AdSense (monetization) ---
# Your AdSense publisher ID, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT_ID=""
# Ad slot IDs created inside your AdSense dashboard.
ADSENSE_SLOT_HEADER=""
ADSENSE_SLOT_SIDEBAR=""
ADSENSE_SLOT_INFEED=""

# Consent Mode v2: set to "true" to require explicit cookie consent (EEA/UK) before loading ads.
CONSENT_REQUIRED="true"

# --- Google Analytics 4 (optional) ---
GA_MEASUREMENT_ID=""
